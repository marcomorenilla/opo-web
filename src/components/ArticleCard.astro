---
import { Icon } from "astro-icon/components";

interface Props {
  title: string;
  content: string[];
  infoArticle: { titulo: string; capitulo: string; seccion: string };
}
const { title, content, infoArticle }: Props = Astro.props;
---

<article
  class="flex flex-col justify-between bg-white w-170 h-150 rounded-xl shadow-xl">
  <header class="px-2 border-b-2 border-slate-400">
    <h2 class="text-center">{title}</h2>
  </header>
  <div class="flex px-2 justify-between items-center">
    <button
      data-prev
      disabled
      class="bg-slate-800 text-white rounded-full font-bold p-2
             hover:scale-105 cursor-pointer
             disabled:opacity-0 disabled:pointer-events-none">
      <Icon name="mdi:arrow-left" />
    </button>
    <p data-content={JSON.stringify(content)} class="px-4"></p>
    <button
      data-next
      class="bg-slate-800 text-white rounded-full font-bold p-2
             hover:scale-105 cursor-pointer
             disabled:opacity-0 disabled:pointer-events-none">
      <Icon name="mdi:arrow-right" />
    </button>
  </div>
  <footer
    class="border-t-2 border-slate-400 flex flex-col justify-center items-center gap-2 py-2">
    {
      infoArticle.titulo && (
        <span class="text-center text-sm  font-bold bg-slate-700 rounded-full p-2 text-white">
          {infoArticle.titulo}
        </span>
      )
    }
    {
      infoArticle.capitulo && (
        <span class="text-center text-sm font-bold bg-slate-700 rounded-full p-2 text-white">
          {infoArticle.capitulo}
        </span>
      )
    }
    {
      infoArticle.seccion && (
        <span class="text-center text-sm font-bold bg-slate-700 rounded-full p-2 text-white">
          {infoArticle.seccion}
        </span>
      )
    }
  </footer>
  <script>
    const paragraph = document.querySelector<HTMLElement>("[data-content]")!;
    const prevButton =
      document.querySelector<HTMLButtonElement>("[data-prev]")!;
    const nextButton =
      document.querySelector<HTMLButtonElement>("[data-next]")!;

    const content: string[] = paragraph.dataset.content
      ? JSON.parse(paragraph.dataset.content)
      : [];

    let index = 0;

    function updateView() {
      const hasContent = content.length > 0;

      paragraph.textContent = hasContent ? content[index] : "";

      updateButton(prevButton, !hasContent || index === 0);
      updateButton(nextButton, !hasContent || index === content.length - 1);
    }

    function updateButton(button: HTMLButtonElement, shouldDisable: boolean) {
      if (button.disabled === shouldDisable) return;

      button.disabled = false;
      button.classList.remove("animate-visibility", "animate-visibility-out");

      // Reinicia la animación aunque se aplique varias veces.
      void button.offsetWidth;

      const animationClass = shouldDisable
        ? "animate-visibility-out"
        : "animate-visibility";

      button.classList.add(animationClass);

      button.addEventListener(
        "animationend",
        () => {
          button.disabled = shouldDisable;
          button.classList.remove(animationClass);
        },
        { once: true },
      );
    }

    prevButton.addEventListener("click", () => {
      if (index === 0) return;

      index--;
      updateView();
      updateButton(prevButton, true);
    });

    nextButton.addEventListener("click", () => {
      if (index >= content.length - 1) return;

      index++;
      updateView();
      updateButton(nextButton, true);
    });

    updateView();
  </script>
</article>
